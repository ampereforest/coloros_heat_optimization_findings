# Patch: Restore Hardware ARP Offload & APFv6 Data Offload on WCN7851 (peach_v2)
# Target Base Port: ColorOS 17 V6 CN (PLZ110_17.0.0.107(CN01), OnePlus 15T base) ported to Xiaomi 15 (dada, SM8750) / Stock HyperOS OS4.0.0.11 vendor base
# Target Path: /vendor/etc/wifi/peach_v2/WCNSS_qcom_cfg.ini
# Notes: Removes hostArpOffload=0 and gApfv6DisableOffloadBitmap=0x0 debug workarounds and enables gEnableNUDFailureNotify=4 (matching ColorOS 16 Beta 3) so Wi-Fi firmware handles ARP/packet filtering without waking AP cores.
# Apply: patch -p1 < vendor_wcnss_qcom_cfg.patch
#
--- a/vendor/etc/wifi/peach_v2/WCNSS_qcom_cfg.ini
+++ b/vendor/etc/wifi/peach_v2/WCNSS_qcom_cfg.ini
@@ -133,14 +133,6 @@
 gBpfFilterEnable=1
 gActiveUcBpfMode=2
 gActiveMcBcBpfMode=1
-# Disable APFv6 data offload mode to avoid JCOPYANDUPDATECNT bug on peach_v2.
-# Default is 0x0F; any non-zero value sets APF_DATA_OFLD_ENABLE in WMI init
-# config, putting the firmware into APFv6 data offload mode where the bug exists.
-# Setting to 0x0 keeps APF_DATA_OFLD_ENABLE=0 and avoids the buggy path.
-gApfv6DisableOffloadBitmap=0x0
-# Disable native ARP offload so ARP packets reach the APF bytecode interpreter.
-# Both settings together are required for ApfV6Test to pass on peach_v2.
-hostArpOffload=0
 
 # Enable NUD tracking feature
 # 0 - disable(default),1 - trigger disconnect, 2 - trigger roaming,
@@ -309,7 +301,7 @@
 gActionOUIAuthAssoc6Mbps2GHz=000c43 04 08000000 F0 01 000c43 04 03000000 F0 01
 
 # Enable notify nud failure event to fwk
-#gEnableNUDFailureNotify=4
+gEnableNUDFailureNotify=4
 
 # Enable notify bmiss event to fwk(self recovery)
 gEnableBmissNoity=1
@@ -328,6 +320,7 @@
 
 # enable Self Recovery
 gEnableSelfRecovery=1
+
 #####################################Xiaomi ADD: END
 
 END
