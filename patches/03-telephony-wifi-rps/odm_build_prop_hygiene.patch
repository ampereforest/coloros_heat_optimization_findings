-ro.product.odm.marketname=OnePlus 15
+ro.product.odm.marketname=OnePlus 15T
 ro.product.odm.name=dada
 ro.product.model_for_attestation=24129PN74C
 ro.product.brand_for_attestation=Xiaomi
@@ -237,8 +237,8 @@
