--- a/odm/etc/build.prop
+++ b/odm/etc/build.prop
@@ -5,9 +5,9 @@
 ro.product.odm.brand=OnePlus
 ro.product.odm.device=dada
 ro.product.odm.manufacturer=OnePlus
-ro.product.odm.model=PLK110
+ro.product.odm.model=PLZ110
