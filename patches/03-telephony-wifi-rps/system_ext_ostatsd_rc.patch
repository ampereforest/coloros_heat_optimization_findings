# Patch: Gate ostatsd Auto-Start Behind persist.sys.ostatsd.enable=1
# Target Base Port: ColorOS 17 V6 CN (PLZ110_17.0.0.107(CN01), OnePlus 15T base) ported to Xiaomi 15 (dada, SM8750) / Stock HyperOS OS4.0.0.11 vendor base
# Target Path: /system_ext/etc/init/ostatsd.rc
# Notes: Prevents ColorOS ostatsd telemetry daemon from launching on persist.sys.midas_ostats.restriction=0 when ostatsd is explicitly disabled.
# Apply: patch -p1 < system_ext_ostatsd_rc.patch
#
--- a/system_ext/etc/init/ostatsd.rc
+++ b/system_ext/etc/init/ostatsd.rc
@@ -16,7 +16,7 @@
 on property:sys.boot_completed=1 && property:persist.sys.ostatsd.start=1
     start ostatsd
 
-on property:sys.boot_completed=1 && property:persist.sys.midas_ostats.restriction=0
+on property:sys.boot_completed=1 && property:persist.sys.midas_ostats.restriction=0 && property:persist.sys.ostatsd.enable=1
     start ostatsd
 
 on property:sys.boot_completed=1 && property:persist.sys.midas_ostats.restriction=1
