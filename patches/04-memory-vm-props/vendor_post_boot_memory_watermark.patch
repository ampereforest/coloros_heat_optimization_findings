# Patch: Lower vm.watermark_scale_factor (65 -> 20) to Eliminate kswapd0 Thrashing
# Target Base Port: ColorOS 17 V6 CN (PLZ110_17.0.0.107(CN01), OnePlus 15T base) ported to Xiaomi 15 (dada, SM8750) / Stock HyperOS OS4.0.0.11 vendor base
# Target Path: /vendor/bin/init.kernel.post_boot-memory.sh
# Notes: Reduces WatermarkScale from 65 to 20 in post_boot memory setup so kswapd0 does not burn continuous CPU reclaiming pages when >6 GB RAM is free (kswapd0 CPU: 20.72s -> 0.00s).
# Apply: patch -p1 < vendor_post_boot_memory_watermark.patch
#
--- a/vendor/bin/init.kernel.post_boot-memory.sh
+++ b/vendor/bin/init.kernel.post_boot-memory.sh
@@ -145,7 +145,7 @@
 	elif [ $RamSizeGB -ge 8 ]; then
 		# 8GB
 		MinFreeKbytes=11584
-		WatermarkScale=65
+		WatermarkScale=20
 		echo $WatermarkScale > /proc/sys/vm/watermark_scale_factor
 
 	elif [ $RamSizeGB -ge 4 ]; then
