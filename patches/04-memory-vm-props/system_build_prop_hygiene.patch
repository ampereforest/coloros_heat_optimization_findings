# Patch: Strip qemu.* props (Duck Virtualization Clear) & add COS17 v7.2+ rootless system hygiene defaults
# Target: /system/build.prop
--- a/system/build.prop
+++ b/system/build.prop
@@ -186,8 +186,6 @@
