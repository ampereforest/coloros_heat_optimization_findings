 #Expose aux camera for below packages
 vendor.camera.aux.packagelist=android,com.oneplus.camera,com.oppo.camera,com.oplus.engineercamera,com.oplus.camera
 #Whitelist below package in privapp
@@ -313,3 +311,12 @@
 import /my_product/build.prop
 import /my_region/build.prop
