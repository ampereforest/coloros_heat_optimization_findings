# Patch: Complete v7.3.1 vendor/build.prop (HDR/LTPO bring-up, thermal/radio hygiene, ostatsd off, CWB timeout 1000ms, RPS mask 3c)
# Target: /vendor/build.prop
--- a/vendor/build.prop
+++ b/vendor/build.prop
@@ -84,7 +84,7 @@
 vendor.audio.compress_capture.aac=true
 vendor.audio.hal.aidl.enabled=true
 ro.usb.uvc.enabled=false
-persist.vendor.radio.md_debug_info.enable=true
+persist.vendor.radio.md_debug_info.enable=false
 vendor.mseccam.auto.start=false
 ro.vendor.miface.started=true
 ro.vendor.mi_fake_32bit_support=true
@@ -293,7 +293,7 @@
 vendor.display.disable_sdr_dimming=0
 vendor.display.enable_rc_support=1
 vendor.display.disable_sdr_histogram=1
-vendor.display.enable_hdr10_gpu_target=1
+vendor.display.enable_hdr10_gpu_target=0
 debug.sf.predict_hwc_composition_strategy=0
 debug.sf.treat_170m_as_sRGB=1
 vendor.display.disable_system_load_check=1
@@ -379,3 +379,49 @@
 ro.vendor.oplus.camera.frontCamSize=32MP
 
 persist.sys.oplus.nandswap.condition=true
+
+# --- Adaptive HDR / LTPO permanent bring-up (BRIEF 6) -----------------
+# Values the KernelSU module used to set with resetprop after boot.
+ro.vendor.display.adaptive_hdr2.enable=true
+vendor.display.hdr.Brighten_support=1
+debug.sf.md_degrade_hdr=false
+debug.sf.connected_display_hdr_v2=true
+persist.nyako.ltpo.force_mode=2
+persist.nyako.ltpo.auto_idle=1
+persist.nyako.ltpo.content_overlay=0
+vendor.display.enable_spec_fence=1
+vendor.display.disable_spec_fence=1
+vendor.display.enable_inline_writeback=0
+vendor.display.enable_posted_start_dyn=0
+vendor.display.timed_render_enable=0
+debug.sf.disable_backpressure=1
+ro.zygote.disable_gl_preload=true
+debug.angle.rules=
+# --- BEGIN COS17 PART A THERMAL & RADIO HYGIENE ---
+persist.vendor.wifi.interrupt_test_mode=false
+ro.telephony.default_network=33,33
+persist.sys.oplus.radio.default_sa=false
+persist.sys.midasd.enable=0
+persist.sys.midasd.start=0
+debug.ostats.bds.enable=0
+persist.sys.oplus.gaia.enable=0
+persist.sys.debuglog.config=
+debug.onetrace.tag=0
+debug.onetrace.native.tag=0
+persist.vendor.sensor.onetrack=false
+persist.nyako.ltpo.log=0
+# --- END COS17 PART A THERMAL & RADIO HYGIENE ---
+# --- BEGIN COS17 V3 OSTATSD & LTPO DEFAULTS ---
+persist.sys.ostatsd.enable=0
+persist.sys.ostatsd.start=0
+persist.sys.ostats_pullerd.enable=0
+persist.sys.ostats_tpd.enable=0
+# --- END COS17 V3 OSTATSD & LTPO DEFAULTS ---
+# --- BEGIN COS17 V5 CWB THROTTLE ---
+# Throttle continuous-frame CWB triggers in libclient2slpi.notifier.so from 200ms (5Hz) -> 1000ms (1Hz)
+# during video/scrolling while keeping instant 150ms misForced=1 CWB on wake/settle and 100% ALS/Prox accuracy.
+ro.vendor.cwb.timeout=1000
+# --- END COS17 V5 CWB THROTTLE ---
+# --- BEGIN COS17 V7 RPS MASK ---
+vendor.usb.rps_mask=3c
+# --- END COS17 V7 RPS MASK ---
