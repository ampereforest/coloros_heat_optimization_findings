# Patch: CWB 1000ms Frame Throttle & Zero-Polling LTPO/HDR Display Properties
# Target Base Port: ColorOS 17 V6 CN (PLZ110_17.0.0.107(CN01), OnePlus 15T base) ported to Xiaomi 15 (dada, SM8750) / Stock HyperOS OS4.0.0.11 vendor base
# Target Path: /vendor/build.prop
# Notes: Sets ro.vendor.cwb.timeout=1000 (-79.5% CWB triggers during 4K60 video/scrolling, 0% screen-off leak) plus adaptive HDR2 and zero-polling LTPO defaults.
# Apply: patch -p1 < vendor_cwb_display_props.patch
#
--- a/vendor/build.prop
+++ b/vendor/build.prop
@@ -368,3 +368,17 @@
 ro.camerax.extensions.enabled=true
 # end of file
 
+
+# --- BEGIN COS17 DISPLAY / LTPO / CWB EFFICIENCY ---
+ro.vendor.display.adaptive_hdr2.enable=true
+vendor.display.hdr.Brighten_support=1
+debug.sf.md_degrade_hdr=false
+debug.sf.connected_display_hdr_v2=true
+persist.nyako.ltpo.force_mode=2
+persist.nyako.ltpo.auto_idle=1
+persist.nyako.ltpo.content_overlay=0
+persist.nyako.ltpo.log=0
+# Throttle continuous-frame CWB triggers in libclient2slpi.notifier.so from 200ms (5Hz) -> 1000ms (1Hz)
+# during video/scrolling while keeping instant 150ms misForced=1 CWB on wake/settle and 100% ALS/Prox accuracy.
+ro.vendor.cwb.timeout=1000
+# --- END COS17 DISPLAY / LTPO / CWB EFFICIENCY ---
