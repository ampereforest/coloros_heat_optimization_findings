# Patch: Restore Xiaomi 15 Thermal-Level FPS Protection Curve (144->120->90->60 Hz)
# Target Base Port: ColorOS 17 V6 CN (PLZ110_17.0.0.107(CN01), OnePlus 15T base) ported to Xiaomi 15 (dada, SM8750) / Stock HyperOS OS4.0.0.11 vendor base
# Target Path: /vendor/etc/display/thermallevel_to_fps.xml
# Notes: Replaces the base port's flattened 144 Hz table across levels 3..10 with Xiaomi 15's stock thermal stepping curve (144 -> 120 -> 90 -> 60 Hz).
# Apply: patch -p1 < vendor_thermallevel_to_fps.patch
#
--- a/vendor/etc/display/thermallevel_to_fps.xml
+++ b/vendor/etc/display/thermallevel_to_fps.xml
@@ -10,14 +10,14 @@
         <Device version="1">
             <ThermalLevelMap level="1" fps="144"/>
             <ThermalLevelMap level="2" fps="144"/>
-            <ThermalLevelMap level="3" fps="144"/>
-            <ThermalLevelMap level="4" fps="144"/>
-            <ThermalLevelMap level="5" fps="144"/>
-            <ThermalLevelMap level="6" fps="144"/>
-            <ThermalLevelMap level="7" fps="144"/>
-            <ThermalLevelMap level="8" fps="144"/>
-            <ThermalLevelMap level="9" fps="144"/>
-            <ThermalLevelMap level="10" fps="144"/>
+            <ThermalLevelMap level="3" fps="120"/>
+            <ThermalLevelMap level="4" fps="120"/>
+            <ThermalLevelMap level="5" fps="90"/>
+            <ThermalLevelMap level="6" fps="90"/>
+            <ThermalLevelMap level="7" fps="90"/>
+            <ThermalLevelMap level="8" fps="60"/>
+            <ThermalLevelMap level="9" fps="60"/>
+            <ThermalLevelMap level="10" fps="60"/>
         </Device>
         <Device version="2">
             <ThermalLevelMap level="1" fps="60"/>
