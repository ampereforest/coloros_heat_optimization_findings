# Patch: ODM ThermalServiceConfig: Disable DCS/Log Uploads & Fix Thermal Zone Path
# Target Base Port: ColorOS 17 V6 CN (PLZ110_17.0.0.107(CN01), OnePlus 15T base) ported to Xiaomi 15 (dada, SM8750) / Stock HyperOS OS4.0.0.11 vendor base
# Target Path: /odm/etc/ThermalServiceConfig/sys_thermal_config.xml
# Notes: Disables DCS/log/errlog upload overhead and remaps thermal_heat_path from missing thermal_zone84 to Xiaomi 15 thermal_zone57.
# Apply: patch -p1 < odm_sys_thermal_config.patch
#
--- a/odm/etc/ThermalServiceConfig/sys_thermal_config.xml
+++ b/odm/etc/ThermalServiceConfig/sys_thermal_config.xml
@@ -10,14 +10,15 @@
     <heat_hold_upload_time>40000</heat_hold_upload_time>
     <heat_align>100</heat_align>
     <is_feature_on>1</is_feature_on>
-    <is_upload_dcs>1</is_upload_dcs>
-    <is_upload_log>1</is_upload_log>
-    <is_upload_errlog>1</is_upload_errlog>
-    <preheat_dex_oat_threshold>380</preheat_dex_oat_threshold>
+    <is_upload_dcs>0</is_upload_dcs>
+    <is_upload_log>0</is_upload_log>
+    <is_upload_errlog>0</is_upload_errlog>
+    <preheat_dex_oat_threshold>420</preheat_dex_oat_threshold>
     <!-- 30min -->
     <heathold_time_threshold>1800000</heathold_time_threshold>
-    <thermal_heat_path>/sys/class/thermal/thermal_zone84/temp</thermal_heat_path>
+    <thermal_heat_path>/sys/class/thermal/thermal_zone57/temp</thermal_heat_path>
     <thermal_battery_temp>1</thermal_battery_temp>
+    <!-- stable battery check threshold -->
     <thermal_monitor_application>
         com.tencent.tmgp.pubgmhd,
         com.tencent.tmgp.sgame,
@@ -25,5 +26,9 @@
         com.smile.gifmaker,
         com.tencent.tmgp.pubgm
     </thermal_monitor_application>
-    <thermal_monitor_app_limit_time>1200000</thermal_monitor_app_limit_time>
+    <thermal_monitor_app_limit_time>2400000</thermal_monitor_app_limit_time>
+    <!-- detect environment time: 10min-->
+    <detect_environment_time_threshold>600000</detect_environment_time_threshold>
+    <!-- detect environment temp: 30C-->
+    <detect_environment_temp_threshold>30</detect_environment_temp_threshold>
 </filter-conf>
