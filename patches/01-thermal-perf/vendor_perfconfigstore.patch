# Patch: Enable SAGT Perf Config on SM8750 (sun)
# Target Base Port: ColorOS 17 V6 CN (PLZ110_17.0.0.107(CN01), OnePlus 15T base) ported to Xiaomi 15 (dada, SM8750) / Stock HyperOS OS4.0.0.11 vendor base
# Target Path: /vendor/etc/perf/perfconfigstore.xml
# Notes: Sets ro.vendor.perf.sagt=true on Target=sun to match ColorOS 16 Beta 3 thermal-perf parity.
# Apply: patch -p1 < vendor_perfconfigstore.patch
#
--- a/vendor/etc/perf/perfconfigstore.xml
+++ b/vendor/etc/perf/perfconfigstore.xml
@@ -121,7 +121,7 @@
                 <Prop Name="ro.vendor.perf.qape.max_boost_count" Value="3" />
                 <Prop Name="ro.vendor.perf.qape.max_pipeline_number" Value="3" />
                 <Prop Name="vendor.perf.bgt.enable" Value="true" />
-                <Prop Name="ro.vendor.perf.sagt" Value="false" Target="sun"/>
+                <Prop Name="ro.vendor.perf.sagt" Value="true" Target="sun"/>
                 <Prop Name="ro.vendor.perf.semiautopipeline" Value="true" Target="sun"/>
                 <Prop Name="ro.vendor.perf.semiautopipeline" Value="false" Target="tuna,kera"/>
                 <Prop Name="ro.vendor.perf.autopipeline" Value="true" Target="sun"/>
