# Patch: Hook KMI-Safe Thermal Efficiency Action into GKI Kernel Build Workflow
# Target Base Port: ColorOS 17 V6 CN (PLZ110_17.0.0.107(CN01), OnePlus 15T base) ported to Xiaomi 15 (dada, SM8750) / Stock HyperOS OS4.0.0.11 vendor base
# Target Path: /.github/workflows/build.yml
# Notes: Applies thermal-efficiency.fragment during android15-6.6 GKI kernel builds in ampereforest/GKI_KernelSU_SUSFS.
# Apply: patch -p1 < build_yml_thermal_hook.patch
#
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -397,6 +397,11 @@
           version: ${{ inputs.version }}
           kernel_version: ${{ inputs.kernel_version }}
 
+      - name: Apply Thermal & Power Efficiency Configs
+        uses: ./.github/actions/thermal-efficiency
+        with:
+          version: ${{ inputs.version }}
+
       - name: Integrate NoMount
         if: contains(inputs.feature_set, 'NoMount') || inputs.feature_set == 'All'
         uses: ./.github/actions/nomount
